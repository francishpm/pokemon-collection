<file path="frontend/src/app/api/tcg/route.ts">
import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

export async function GET(request: Request) {
  try {
    const { searchParams } = new URL(request.url);
    const cardName = searchParams.get("name");
    const cardNumber = searchParams.get("number");

    if (!cardName) {
      return NextResponse.json({ error: "O nome da carta é obrigatório" }, { status: 400 });
    }

    // 🔥 O TRUQUE ANTI-ERRO 500 🔥
    // Pegamos só o primeiro nome e passamos direto na URL, sem codificar os dois-pontos!
    const safeName = cardName.split(" ")[0].toLowerCase(); 
    const tcgUrl = `https://api.pokemontcg.io/v2/cards?q=name:${safeName}`;
    
    const tcgResponse = await fetch(tcgUrl);
    
    if (!tcgResponse.ok) {
        throw new Error(`A TCG API falhou. Status: ${tcgResponse.status}`);
    }
    
    const tcgData = await tcgResponse.json();

    if (!tcgData.data || tcgData.data.length === 0) {
       return NextResponse.json({ success: false, message: "Carta não encontrada na base global." });
    }

    // O nosso código faz o trabalho duro de achar o número exato, sem depender da busca deles!
    let card = tcgData.data.find((c: any) => c.number === cardNumber);
    
    // Se por acaso não achar o número exato, pega a primeira carta só pra não quebrar
    if (!card) {
        card = tcgData.data[0];
    }
    
    // Busca os preços
    const prices = card.tcgplayer?.prices;
    let marketPriceUSD = 0;

    if (prices) {
        if (prices.holofoil?.market) marketPriceUSD = prices.holofoil.market;
        else if (prices.normal?.market) marketPriceUSD = prices.normal.market;
        else if (prices.reverseHolofoil?.market) marketPriceUSD = prices.reverseHolofoil.market;
    }

    // BUSCA A COTAÇÃO DO DÓLAR EM TEMPO REAL (AwesomeAPI)
    const cotacaoResponse = await fetch("https://economia.awesomeapi.com.br/last/USD-BRL");
    
    if (!cotacaoResponse.ok) {
        throw new Error(`A API de Cotação falhou. Status: ${cotacaoResponse.status}`);
    }

    const cotacaoData = await cotacaoResponse.json();
    const valorDolarHoje = parseFloat(cotacaoData.USDBRL.ask);

    // FAZ A CONVERSÃO
    const marketPriceBRL = marketPriceUSD * valorDolarHoje;

    return NextResponse.json({
      success: true,
      cardFound: card.name,
      set: card.set.name,
      cardNumber: card.number,
      image: card.images.small,
      cotacaoDolarUsada: valorDolarHoje,
      prices: {
        usd: marketPriceUSD,
        brl: marketPriceBRL,
        usdText: `$ ${marketPriceUSD.toFixed(2)}`,
        brlText: `R$ ${marketPriceBRL.toFixed(2).replace(".", ",")}`
      }
    });

  } catch (error: any) {
    console.error("Erro na API TCG:", error);
    return NextResponse.json({ success: false, error: error.message }, { status: 500 });
  }
}
